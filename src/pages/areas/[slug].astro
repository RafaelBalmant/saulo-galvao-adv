---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Contato from '../../components/Contato.astro';
import Icone from '../../components/Icone.astro';
import foto from '../../assets/saulo-trabalhando.jpg';
import site from '../../data/site.json';
import { linkWhatsapp } from '../../lib/whatsapp';

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  return areas.map((area) => ({ params: { slug: area.id }, props: { area } }));
}
const { area } = Astro.props;
const d = area.data;
const wa = linkWhatsapp(d.mensagemWhatsapp);
const credenciais = ['Pós em Direito Tributário', 'Especialista em Direito Empresarial', 'MBA em Finanças'];
const faqSchema = d.faq.length
  ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.pergunta, acceptedAnswer: { '@type': 'Answer', text: f.resposta } })) }]
  : [];
---
<Base title={d.seoTitle} description={d.seoDescription} mensagemWhatsapp={d.mensagemWhatsapp} schemaExtra={faqSchema}>
  <script is:inline define:vars={{ area: area.id }}>document.body.dataset.area = area;</script>

  <section class="relative overflow-hidden bg-marinho text-white">
    <div class="container-site grid items-center gap-10 py-10 md:grid-cols-[1.15fr_0.85fr] md:py-20">
      <div>
        <p class="eyebrow !text-white/60">{d.titulo}</p>
        <h1 class="mt-4 text-[1.75rem] font-semibold leading-tight !text-white sm:text-4xl lg:text-5xl">{d.h1}</h1>
        <p class="mt-4 max-w-xl text-[0.95rem] leading-relaxed text-white/75 sm:mt-6 sm:text-lg">{d.subtitulo}</p>
        <div class="mt-7 flex flex-col gap-3 sm:mt-9 sm:flex-row">
          <a href={wa} target="_blank" rel="noopener" data-conversao="whatsapp_click" data-local="hero_lp" class="btn-primario"><Icone nome="whatsapp" class="h-5 w-5" />Agendar Consulta</a>
          <a href="#contato" class="btn-contorno">Enviar mensagem</a>
        </div>
        <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/70">
          {credenciais.map((c) => <li class="flex items-center gap-2"><Icone nome="check" class="h-4 w-4 text-white" />{c}</li>)}
        </ul>
      </div>
      <Image src={foto} alt={`${site.advogado} em atendimento`} widths={[400, 640, 900]} sizes="(min-width: 768px) 38vw, 90vw" class="aspect-[4/3] w-full rounded-lg object-cover shadow-2xl md:aspect-[4/5]" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <section class="bg-white py-20 lg:py-24">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow">Como atuamos</p>
        <h2 class="mt-4 text-3xl font-semibold leading-tight sm:text-4xl">{d.titulo}</h2>
        <p class="mt-5 leading-relaxed">{d.resumo}</p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {d.topicos.map((t) => (
          <article class="rounded-lg border border-marinho/10 bg-gelo p-7 transition hover:border-vinho/30 hover:shadow-lg">
            <h3 class="text-lg font-semibold">{t.titulo}</h3>
            <p class="mt-3 leading-relaxed">{t.texto}</p>
          </article>
        ))}
      </div>
      <div class="mt-14 flex flex-col items-start justify-between gap-6 rounded-lg bg-marinho p-8 text-white sm:flex-row sm:items-center sm:p-10">
        <div>
          <h3 class="text-2xl font-semibold !text-white">Precisa de suporte jurídico?</h3>
          <p class="mt-2 text-white/70">Apresente o cenário e agende uma conversa inicial com o escritório.</p>
        </div>
        <a href={wa} target="_blank" rel="noopener" data-conversao="whatsapp_click" data-local="cta_lp" class="btn-primario shrink-0">Solicitar Análise de Cenário</a>
      </div>
    </div>
  </section>

  {d.faq.length > 0 && (
    <section class="border-t border-marinho/10 bg-white pb-20 lg:pb-24">
      <div class="container-site max-w-3xl pt-20">
        <p class="eyebrow">Dúvidas frequentes</p>
        <h2 class="mt-4 text-3xl font-semibold">Perguntas frequentes</h2>
        <div class="mt-10 divide-y divide-marinho/10 border-y border-marinho/10">
          {d.faq.map((f) => (
            <details class="group py-5" name="faq">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-titulo font-semibold text-marinho [&::-webkit-details-marker]:hidden">
                {f.pergunta}<Icone nome="mais" class="h-5 w-5 shrink-0 text-vinho transition-transform group-open:rotate-45" />
              </summary>
              <p class="mt-3 leading-relaxed">{f.resposta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <Contato area={area.id} />
</Base>
