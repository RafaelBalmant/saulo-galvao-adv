---
import '../styles/global.css';
import site from '../data/site.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsappFlutuante from '../components/WhatsappFlutuante.astro';
import BannerCookies from '../components/BannerCookies.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  mensagemWhatsapp?: string;
  schemaExtra?: Record<string, unknown>[];
}
const { title, description, image = '/og.jpg', noindex = false, mensagemWhatsapp, schemaExtra = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const gtm = site.gtmId;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LegalService',
    name: site.nome,
    slogan: site.slogan,
    url: Astro.site?.toString(),
    logo: new URL('/icon-512.png', Astro.site).toString(),
    image: new URL(image, Astro.site).toString(),
    telephone: [`+${site.whatsapp}`, `+${site.telefone2}`],
    email: site.email,
    ...(site.endereco ? { address: { '@type': 'PostalAddress', streetAddress: site.endereco, addressLocality: site.cidade, addressRegion: site.uf, addressCountry: 'BR' } } : {}),
    founder: { '@type': 'Person', name: site.advogado, jobTitle: 'Advogado' },
  },
  ...schemaExtra,
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <meta name="theme-color" content="#0F1E36" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Consent Mode v2: tudo negado até o visitante aceitar (LGPD) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      var c = null; try { c = localStorage.getItem('consentimento'); } catch (e) {}
      var ok = c === 'aceito' ? 'granted' : 'denied';
      gtag('consent', 'default', { ad_storage: ok, ad_user_data: ok, ad_personalization: ok, analytics_storage: ok, wait_for_update: 500 });
      gtag('set', 'ads_data_redaction', ok === 'denied');
      gtag('set', 'url_passthrough', true);
    </script>
    {gtm && (
      <script is:inline define:vars={{ gtm }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);
      </script>
    )}
  </head>
  <body class="min-h-screen">
    {gtm && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtm}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>}
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-white focus:px-4 focus:py-2">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <WhatsappFlutuante mensagem={mensagemWhatsapp} />
    <BannerCookies />

    <!-- Rastreamento de conversões: cliques em WhatsApp, telefone e e-mail -->
    <script>
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-conversao]');
        if (!el) return;
        const w = window as any;
        w.dataLayer = w.dataLayer || [];
        w.dataLayer.push({
          event: el.dataset.conversao, // whatsapp_click | phone_click | email_click
          cta_local: el.dataset.local || '',
          area_atuacao: document.body.dataset.area || '',
        });
      });
    </script>
  </body>
</html>
