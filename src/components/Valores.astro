---
import Icone from './Icone.astro';
const valores = [
  { icone: 'alvo', titulo: 'Pragmatismo de Negócios', texto: 'Soluções jurídicas aplicáveis ao dia a dia, focadas em viabilizar operações e mitigar riscos.' },
  { icone: 'balanca', titulo: 'Transparência e Ética', texto: 'Relacionamento direto, clareza sobre riscos e alinhamento constante em cada etapa da atuação.' },
  { icone: 'escudo', titulo: 'Visão Preventiva', texto: 'Mitigação antecedente de conflitos para proteger o patrimônio e a perenidade do negócio.' },
];
---
<section id="valores" class="bg-gelo py-20 lg:py-28">
  <div class="container-site">
    <div class="max-w-2xl">
      <p class="eyebrow">Princípios e Valores</p>
      <h2 class="mt-4 text-3xl font-semibold leading-tight sm:text-4xl">Como conduzimos cada atuação</h2>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {valores.map((v) => (
        <article class="group rounded-lg border border-marinho/10 bg-white p-8 transition duration-300 hover:-translate-y-1 hover:border-vinho/30 hover:shadow-xl">
          <div class="flex h-12 w-12 items-center justify-center rounded-md bg-marinho text-white transition-colors group-hover:bg-vinho">
            <Icone nome={v.icone} />
          </div>
          <h3 class="mt-6 text-lg font-semibold">{v.titulo}</h3>
          <p class="mt-3 leading-relaxed">{v.texto}</p>
        </article>
      ))}
    </div>
  </div>
</section>
