<div id="banner-cookies" hidden class="fixed inset-x-3 bottom-3 z-50 mx-auto max-w-3xl rounded-lg border border-grafite/10 bg-white p-4 sm:p-5 shadow-2xl sm:flex sm:items-center sm:gap-6">
  <p class="text-xs leading-relaxed text-grafite sm:text-sm">
    Utilizamos cookies para medir o desempenho do site e de nossas campanhas. Você pode aceitar ou recusar.
    Saiba mais na <a href="/politica-de-privacidade" class="underline hover:text-vinho">Política de Privacidade</a>.
  </p>
  <div class="mt-3 flex shrink-0 gap-2 sm:mt-0">
    <button type="button" data-consent="recusado" class="btn-contorno-escuro flex-1 !px-4 !py-2 sm:flex-none">Recusar</button>
    <button type="button" data-consent="aceito" class="btn-primario flex-1 !px-4 !py-2 sm:flex-none">Aceitar</button>
  </div>
</div>
<script>
  const banner = document.getElementById('banner-cookies')!;
  let atual: string | null = null;
  try { atual = localStorage.getItem('consentimento'); } catch {}
  if (!atual) banner.hidden = false;
  banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
    b.addEventListener('click', () => {
      const v = b.dataset.consent!;
      try { localStorage.setItem('consentimento', v); } catch {}
      const s = v === 'aceito' ? 'granted' : 'denied';
      const w = window as any;
      w.gtag?.('consent', 'update', { ad_storage: s, ad_user_data: s, ad_personalization: s, analytics_storage: s });
      w.dataLayer?.push({ event: 'consentimento_' + v });
      banner.hidden = true;
    }),
  );
</script>
