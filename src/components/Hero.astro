---
import { Image } from 'astro:assets';
import foto from '../assets/saulo-hero.jpg';
import site from '../data/site.json';
import { linkWhatsapp } from '../lib/whatsapp';
---
<section class="relative overflow-hidden bg-marinho text-white">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(255,255,255,0.08),transparent_60%)]"></div>
  <div class="container-site relative grid items-center gap-10 py-10 md:grid-cols-[1.1fr_0.9fr] md:py-20 lg:py-24">
    <div>
      <p class="eyebrow !text-white/60">Advocacia Empresarial</p>
      <h1 class="mt-4 text-[1.75rem] font-semibold leading-tight !text-white sm:text-4xl lg:text-5xl">{site.slogan}</h1>
      <p class="mt-4 max-w-xl text-[0.95rem] leading-relaxed text-white/75 sm:mt-6 sm:text-lg">
        Inteligência jurídica, gestão de riscos e suporte estratégico para empresas e empresários, com visão que une o Direito à compreensão financeira do negócio.
      </p>
      <div class="mt-7 flex flex-col gap-3 sm:mt-9 sm:flex-row">
        <a href={linkWhatsapp()} target="_blank" rel="noopener" data-conversao="whatsapp_click" data-local="hero" class="btn-primario">Agendar Consulta</a>
        <a href="#areas" class="btn-contorno">Conheça as áreas de atuação</a>
      </div>
    </div>
    <div class="relative mx-auto w-full max-w-md md:max-w-none">
      <div class="absolute -bottom-3 -right-3 h-full w-full rounded-lg border border-white/15"></div>
      <Image src={foto} alt={`${site.advogado}, advogado`} widths={[400, 640, 900]} sizes="(min-width: 768px) 40vw, 90vw" class="relative aspect-[4/5] w-full rounded-lg object-cover object-top shadow-2xl" loading="eager" fetchpriority="high" />
    </div>
  </div>
</section>
